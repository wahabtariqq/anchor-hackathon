VITE_API_URL=http://localhost:8000

# Frontend-only mode: serves contracts/fixtures/*.json instead of calling the API, and makes
# lib/auth.ts use its local mock account store. Useful for demoing the UI with no backend.
# Leave it false for the real thing — auth, onboarding, roadmap, progress and Prove It all
# talk to the API now. /dashboard, /skills and /projects come from fixtures either way until
# the events lane lands (see PENDING_ENDPOINTS in src/lib/api.ts).
VITE_USE_FIXTURE=false
