VITE_API_URL=http://localhost:8000

# Frontend-only mode: serves contracts/fixtures/*.json instead of calling the API, and makes
# lib/auth.ts use its local mock account store. Useful for demoing the UI with no backend.
# Leave it false for the real thing — every screen now talks to the API, /dashboard, /skills
# and /projects included.
VITE_USE_FIXTURE=false
