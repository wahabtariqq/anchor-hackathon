# SQLite by default: `cp .env.example .env` then `python scripts/seed_db.py` works with no
# Postgres, no Docker, no account. This is the day-to-day setting and the one a reviewer
# cloning the repo should get.
DATABASE_URL=sqlite:///./dev.db
# Deployed / shared Postgres instead — Supabase SESSION pooler, port 5432, NOT the 6543
# transaction pooler (it breaks prepared statements). Uncomment and fill in to use it:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# --- model provider (DECISIONS #39, #45, #46) ---
# Free key from Google AI Studio, no card required.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Declared fallback only. Not used while LLM_PROVIDER=gemini.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANALYSIS_MAX_TOKENS=16000
ANALYSIS_RETRY_MAX_TOKENS=24000
DEMO_MODE=false
DEMO_STUDENT_NAME=Ayesha
# The repo contracts/fixtures/demo_review.json was generated against. Changing this without
# regenerating that fixture means the demo submit path falls through to a live review.
DEMO_REPO_URL=https://github.com/Umer-prog/cached-product-search-api
GITHUB_TOKEN=ghp_...
REVIEW_PASS_RATIO=0.6
CORS_ORIGINS=http://localhost:5173
